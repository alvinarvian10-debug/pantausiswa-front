# FRONTEND ONLY — tidak ada koneksi database di sini.
# Salin menjadi `.env`. Backend = NestJS di sysch/back.
# .env TIDAK boleh di-commit (sudah ada di .gitignore).

# URL backend NestJS (tanpa trailing slash).
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# WAJIB sama persis dengan JWT_SECRET di sysch/back/.env
# (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))").
JWT_SECRET=""

# Opsi: COOKIE_SECURE=true (paksa Secure) / false (paksa non-Secure).
# Default: otomatis mengikuti protokol (aman untuk localhost HTTP + production HTTPS).
#COOKIE_SECURE=""
