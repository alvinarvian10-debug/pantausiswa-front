# Salin file ini menjadi `.env`, lalu isi nilai yang kosong.
# .env TIDAK boleh di-commit (sudah ada di .gitignore).

# Koneksi MySQL XAMPP. Format: mysql://USER:PASSWORD@HOST:PORT/NAMA_DB
# XAMPP default: user root, password kosong.
DATABASE_URL="mysql://root:@localhost:3306/pantausiswa-db"

# Kunci tanda tangan cookie sesi (wajib, minimal 32 karakter acak).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Kunci sekali pakai untuk seeding akun awal via POST /api/auth/seed.
# HAPUS baris ini (atau hapus route seed) setelah seeding berhasil.
SETUP_KEY=""
